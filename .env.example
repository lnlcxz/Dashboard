# =============================================================================
# Dashboard Open Finance — Variáveis de ambiente (PASSO 1)
# Copie para .env e preencha. NUNCA commite o arquivo .env
# =============================================================================

# --- Ambiente ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=sua_anon_key_publica
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_secreta

# --- PostgreSQL (Project Settings → Database) ---
# Pooler (app runtime) + Direct (Prisma migrate)
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# --- Redis (local via Docker no Épico 0) ---
REDIS_URL=redis://localhost:6379

# --- Criptografia (gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ---
ENCRYPTION_KEY=substitua_por_64_caracteres_hex

# --- API Fastify ---
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
CSRF_SECRET=substitua_por_string_aleatoria_longa

# --- Next.js (apps/web) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_publica
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Open Finance Brasil (Épico 2 — deixar vazio no Passo 1) ---
OFB_CERT_PATH=
OFB_KEY_PATH=
OFB_CA_PATH=
OFB_DIRECTORY_URL=https://data.sandbox.directory.openbankingbrasil.org.br

# --- Webhooks (Épico 2) ---
WEBHOOK_HMAC_SECRET=substitua_quando_configurar_webhooks

# --- Doppler (opcional) ---
# DOPPLER_TOKEN=
# DOPPLER_PROJECT=dashboard-openfinance
# DOPPLER_CONFIG=dev

# --- Observabilidade (Épico 11 — opcional no Passo 1) ---
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
